@if (IsOpen)
{
    <div @ref="modalOverlay" @onclick="HandleBackdropClickAsync" @onkeydown="HandleKeyDownAsync" tabindex="-1" class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-[#3F362E]/30 px-4 py-8 backdrop-blur-[2px] sm:items-center sm:px-6" role="presentation">
        <section @onclick:stopPropagation="true" class="w-full max-w-[580px] overflow-hidden rounded-[24px] border border-[#ECE0D0] bg-[#FBF4EC] shadow-[0_20px_50px_-24px_rgba(63,54,46,0.35)]" role="dialog" aria-modal="true" aria-labelledby="create-post-title">
            <header class="flex items-center justify-between border-b border-[#ECE0D0] px-[26px] py-5">
                <button type="button" class="text-[15px] font-bold text-[#94887B]" @onclick="HandleCancelAsync">Cancelar</button>
                <h2 id="create-post-title" class="font-fredoka text-lg font-semibold text-[#3F362E]">Nueva publicación</h2>
                <button type="button" class="text-[15px] font-extrabold text-[#D9583C]" @onclick="HandlePublish">Publicar</button>
            </header>

            <form class="px-[26px] py-6" novalidate @onsubmit:preventDefault="true">
                <fieldset class="mb-[22px]">
                    <legend class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">PARA</legend>
                    <div class="flex flex-wrap gap-[9px]">
                        @foreach (var kid in KidCatalog.All)
                        {
                            <button type="button" aria-pressed="@draft.SelectedKidSlugs.Contains(kid.Slug)" class="@GetKidChipClass(kid.Slug)" @onclick="() => ToggleKid(kid.Slug)">
                                <span class="flex size-[26px] items-center justify-center rounded-full font-fredoka text-[13px] font-semibold @kid.AvatarBackgroundClass @kid.AvatarTextClass">@kid.Initials</span>
                                @kid.FullName
                            </button>
                        }
                        <button type="button" aria-pressed="@draft.IsRoomSelected" class="@GetRoomChipClass()" @onclick="ToggleRoom">Toda la sala</button>
                    </div>
                    @if (recipientError is not null)
                    {
                        <p class="mt-1.5 text-[13px] font-semibold text-[#C5503A]">@recipientError</p>
                    }
                </fieldset>

                <fieldset class="mb-[22px]">
                    <legend class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">TIPO</legend>
                    <div class="flex flex-wrap gap-[9px]">
                        @foreach (var kind in PostKinds)
                        {
                            <button type="button" aria-pressed="@(draft.Kind == kind)" class="@GetKindClass(kind)" @onclick="() => draft.Kind = kind">@kind</button>
                        }
                    </div>
                </fieldset>

                <div class="mb-[22px]">
                    <label class="mb-2.5 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="post-description">DESCRIPCIÓN</label>
                    <textarea id="post-description" placeholder="Cuenta cómo le fue hoy…" @bind="draft.Description" @bind:event="oninput" class="min-h-[120px] w-full resize-y rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[14px] text-[15px] leading-[1.5] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus:border-[#F2937A]"></textarea>
                    @if (descriptionError is not null)
                    {
                        <p class="mt-1.5 text-[13px] font-semibold text-[#C5503A]">@descriptionError</p>
                    }
                </div>

                <section aria-labelledby="post-photos-title">
                    <h3 id="post-photos-title" class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">FOTOS</h3>
                    <div class="flex gap-3">
                        <div class="flex size-24 items-center justify-center rounded-[14px] border border-[#ECE0D0] bg-[#F4ECE1] text-[#CBB89F]" aria-label="Vista previa de foto">
                            <svg class="size-[26px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                <circle cx="9" cy="9" r="2" />
                                <path d="m21 15-3.6-3.6a2 2 0 0 0-2.8 0L6 21" />
                            </svg>
                        </div>
                        <div class="flex size-24 flex-col items-center justify-center gap-1.5 rounded-[14px] border-[1.5px] border-dashed border-[#DBCDBA] bg-[#F4ECE1] text-[#B0A290]" aria-label="Agregar foto">
                            <svg class="size-[22px] text-[#C5503A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            <span class="text-xs">Agregar</span>
                        </div>
                    </div>
                </section>
            </form>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    private static readonly string[] PostKinds = ["Comida", "Siesta", "Actividad", "Logro", "Ánimo", "Foto", "Anuncio"];
    private CreatePostDraft draft = new();
    private string? recipientError;
    private string? descriptionError;
    private ElementReference modalOverlay;
    private bool shouldFocusModal;
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            shouldFocusModal = true;
        }

        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusModal)
        {
            shouldFocusModal = false;
            await modalOverlay.FocusAsync(preventScroll: true);
        }
    }

    private string GetKidChipClass(string slug) => draft.SelectedKidSlugs.Contains(slug)
        ? "flex items-center gap-2 rounded-full border-[1.5px] border-[#3F362E] bg-[#3F362E] py-[6px] pr-[14px] pl-[6px] text-sm font-bold text-white"
        : "flex items-center gap-2 rounded-full border-[1.5px] border-[#ECE0D0] bg-[#FFFDF9] py-[6px] pr-[14px] pl-[6px] text-sm font-bold text-[#6E6359]";

    private string GetRoomChipClass() => draft.IsRoomSelected
        ? "rounded-full border-[1.5px] border-[#3F362E] bg-[#3F362E] px-4 py-[6px] text-sm font-bold text-white"
        : "rounded-full border-[1.5px] border-[#ECE0D0] bg-[#FFFDF9] px-4 py-[6px] text-sm font-bold text-[#6E6359]";

    private string GetKindClass(string kind)
    {
        var colorClass = kind switch
        {
            "Comida" => "bg-[#9A7B1E] text-white",
            "Siesta" => "bg-[#E7DCF6] text-[#7B5FC0]",
            "Actividad" => "bg-[#2E89A6] text-white",
            "Logro" => "bg-[#CFEBD8] text-[#3E9B6C]",
            "Ánimo" => "bg-[#F9D2DE] text-[#C56486]",
            "Foto" => "bg-[#FBD8CC] text-[#D9684A]",
            "Anuncio" => "bg-[#CCD8F4] text-[#4E72C8]",
            _ => string.Empty
        };

        return $"rounded-full border-0 px-4 py-2 text-[13.5px] font-extrabold {colorClass} {(draft.Kind == kind ? "ring-2 ring-[#3F362E] ring-offset-2" : string.Empty)}";
    }

    private void ToggleKid(string slug)
    {
        draft.IsRoomSelected = false;

        if (!draft.SelectedKidSlugs.Add(slug))
        {
            draft.SelectedKidSlugs.Remove(slug);
        }
    }

    private void ToggleRoom()
    {
        draft.IsRoomSelected = !draft.IsRoomSelected;

        if (draft.IsRoomSelected)
        {
            draft.SelectedKidSlugs.Clear();
        }
    }

    private async Task HandlePublish()
    {
        recipientError = draft.SelectedKidSlugs.Count == 0 && !draft.IsRoomSelected
            ? "Selecciona al menos un destinatario."
            : null;
        descriptionError = string.IsNullOrWhiteSpace(draft.Description)
            ? "Escribe una descripción."
            : null;

        if (recipientError is not null || descriptionError is not null)
        {
            return;
        }

        await CloseAsync(OnSave);
    }

    private Task HandleCancelAsync() => CloseAsync(OnCancel);

    private Task HandleBackdropClickAsync() => CloseAsync(OnCancel);

    private Task HandleKeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape"
        ? CloseAsync(OnCancel)
        : Task.CompletedTask;

    private async Task CloseAsync(EventCallback callback)
    {
        ResetDraft();
        await callback.InvokeAsync();
    }

    private void ResetDraft()
    {
        draft = new CreatePostDraft();
        recipientError = null;
        descriptionError = null;
    }

    private sealed class CreatePostDraft
    {
        public HashSet<string> SelectedKidSlugs { get; } = [];
        public bool IsRoomSelected { get; set; }
        public string Kind { get; set; } = "Comida";
        public string Description { get; set; } = string.Empty;
    }
}
