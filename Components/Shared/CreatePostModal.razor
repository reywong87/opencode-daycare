@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-[#3F362E]/30 px-4 py-8 backdrop-blur-[2px] sm:items-center sm:px-6" role="presentation">
        <section class="w-full max-w-[580px] overflow-hidden rounded-[24px] border border-[#ECE0D0] bg-[#FBF4EC] shadow-[0_20px_50px_-24px_rgba(63,54,46,0.35)]" role="dialog" aria-modal="true" aria-labelledby="create-post-title">
            <header class="flex items-center justify-between border-b border-[#ECE0D0] px-[26px] py-5">
                <button type="button" class="text-[15px] font-bold text-[#94887B]">Cancelar</button>
                <h2 id="create-post-title" class="font-fredoka text-lg font-semibold text-[#3F362E]">Nueva publicación</h2>
                <button type="button" class="text-[15px] font-extrabold text-[#D9583C]">Publicar</button>
            </header>

            <form class="px-[26px] py-6" novalidate>
                <fieldset class="mb-[22px]">
                    <legend class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">PARA</legend>
                    <div class="flex flex-wrap gap-[9px]">
                        @foreach (var kid in KidCatalog.All)
                        {
                            <button type="button" aria-pressed="@selectedKidSlugs.Contains(kid.Slug)" class="@GetKidChipClass(kid.Slug)" @onclick="() => ToggleKid(kid.Slug)">
                                <span class="flex size-[26px] items-center justify-center rounded-full font-fredoka text-[13px] font-semibold @kid.AvatarBackgroundClass @kid.AvatarTextClass">@kid.Initials</span>
                                @kid.FullName
                            </button>
                        }
                        <button type="button" aria-pressed="@isRoomSelected" class="@GetRoomChipClass()" @onclick="ToggleRoom">Toda la sala</button>
                    </div>
                </fieldset>

                <fieldset class="mb-[22px]">
                    <legend class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">TIPO</legend>
                    <div class="flex flex-wrap gap-[9px]"></div>
                </fieldset>

                <div class="mb-[22px]">
                    <label class="mb-2.5 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="post-description">DESCRIPCIÓN</label>
                    <textarea id="post-description" placeholder="Cuenta cómo le fue hoy…" class="min-h-[120px] w-full resize-y rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[14px] text-[15px] leading-[1.5] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus:border-[#F2937A]"></textarea>
                </div>

                <section aria-labelledby="post-photos-title">
                    <h3 id="post-photos-title" class="mb-2.5 text-xs font-extrabold tracking-[0.7px] text-[#94887B]">FOTOS</h3>
                    <div class="flex gap-3">
                        <div class="flex size-24 items-center justify-center rounded-[14px] border border-[#ECE0D0] bg-[#F4ECE1] text-[#CBB89F]" aria-label="Vista previa de foto">
                            <svg class="size-[26px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                <circle cx="9" cy="9" r="2" />
                                <path d="m21 15-3.6-3.6a2 2 0 0 0-2.8 0L6 21" />
                            </svg>
                        </div>
                        <div class="flex size-24 flex-col items-center justify-center gap-1.5 rounded-[14px] border-[1.5px] border-dashed border-[#DBCDBA] bg-[#F4ECE1] text-[#B0A290]" aria-label="Agregar foto">
                            <svg class="size-[22px] text-[#C5503A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            <span class="text-xs">Agregar</span>
                        </div>
                    </div>
                </section>
            </form>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    private readonly HashSet<string> selectedKidSlugs = [];
    private bool isRoomSelected;

    private string GetKidChipClass(string slug) => selectedKidSlugs.Contains(slug)
        ? "flex items-center gap-2 rounded-full border-[1.5px] border-[#3F362E] bg-[#3F362E] py-1 pr-[14px] pl-1 text-sm font-bold text-white"
        : "flex items-center gap-2 rounded-full border-[1.5px] border-[#ECE0D0] bg-[#FFFDF9] py-1 pr-[14px] pl-1 text-sm font-bold text-[#6E6359]";

    private string GetRoomChipClass() => isRoomSelected
        ? "rounded-full border-[1.5px] border-[#3F362E] bg-[#3F362E] px-4 py-[7px] text-sm font-bold text-white"
        : "rounded-full border-[1.5px] border-[#ECE0D0] bg-[#FFFDF9] px-4 py-[7px] text-sm font-bold text-[#6E6359]";

    private void ToggleKid(string slug)
    {
        isRoomSelected = false;

        if (!selectedKidSlugs.Add(slug))
        {
            selectedKidSlugs.Remove(slug);
        }
    }

    private void ToggleRoom()
    {
        isRoomSelected = !isRoomSelected;

        if (isRoomSelected)
        {
            selectedKidSlugs.Clear();
        }
    }
}
