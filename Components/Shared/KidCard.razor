@using Microsoft.AspNetCore.Components
@using OpenDaycare.Dtos

<NavLink href="@($"/kids/{Child.Slug}")" class="block no-underline">
    <article class="flex min-w-0 items-center gap-3.5 rounded-[18px] border border-[#ECE0D0] bg-[#FFFDF9] p-4 shadow-[0_4px_14px_-12px_rgba(120,90,60,0.5)]">
        <Avatar Initials="@Initials" BackgroundClass="@AvatarBackgroundClass" TextClass="@AvatarTextClass" SizeClass="size-12 text-[19px]" />
        <div class="min-w-0 flex-1">
            <p class="truncate font-fredoka text-base font-semibold text-[#3F362E]">@Child.FullName</p>
            <p class="text-[13px] text-[#A89A8B]">@Child.BirthDate.ToString("d MMM yyyy") · @Child.RoomName</p>
            @if (!string.IsNullOrWhiteSpace(Child.MedicalNotes))
            {
                <p class="mt-1 truncate text-[12px] font-semibold text-[#B36958]">@Child.MedicalNotes</p>
            }
        </div>
    </article>
</NavLink>

@code {
    [Parameter, EditorRequired]
    public ChildListItem Child { get; set; } = null!;

    private string Initials => string.Concat(Child.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private string AvatarBackgroundClass => AvatarColors[Child.Id.ToByteArray()[0] % AvatarColors.Length].BackgroundClass;

    private string AvatarTextClass => AvatarColors[Child.Id.ToByteArray()[0] % AvatarColors.Length].TextClass;

    private static readonly (string BackgroundClass, string TextClass)[] AvatarColors =
    [
        ("bg-[#A9D9E8]", "text-[#1F7A93]"),
        ("bg-[#F4B8CC]", "text-[#C44A7A]"),
        ("bg-[#B9DEC4]", "text-[#3E8B62]"),
        ("bg-[#F4DC8E]", "text-[#9A7B1E]"),
        ("bg-[#C9B6E8]", "text-[#7B5FC0]")
    ];
}
