@using OpenDaycare.Dtos
@using OpenDaycare.Models

@if (IsOpen)
{
    <div @ref="modalOverlay" @onclick="HandleBackdropClickAsync" @onkeydown="HandleKeyDownAsync" tabindex="-1" class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-[#3F362E]/30 px-4 py-8 backdrop-blur-[2px] sm:items-center sm:px-6" role="presentation">
        <section @onclick:stopPropagation="true" class="w-full max-w-[520px] overflow-hidden rounded-[24px] border border-[#ECE0D0] bg-[#FBF4EC] shadow-[0_20px_50px_-24px_rgba(63,54,46,0.35)]" role="dialog" aria-modal="true" aria-labelledby="add-kid-title">
            <header class="flex items-center justify-between border-b border-[#ECE0D0] px-[26px] py-5">
                <button type="button" disabled="@isSaving" class="cursor-pointer text-[15px] font-bold text-[#94887B] disabled:cursor-not-allowed disabled:opacity-60" @onclick="HandleCancelAsync">Cancelar</button>
                <h2 id="add-kid-title" class="font-fredoka text-lg font-semibold text-[#3F362E]">Agregar niño</h2>
                <button type="button" disabled="@isSaving" class="cursor-pointer text-[15px] font-extrabold text-[#D9583C] disabled:cursor-not-allowed disabled:opacity-60" @onclick="HandleSaveAsync">@(isSaving ? "Guardando..." : "Guardar")</button>
            </header>

            <form class="space-y-[18px] px-[26px] py-6" novalidate>
                <div>
                    <label class="mb-2 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="kid-full-name">NOMBRE COMPLETO</label>
                    <input id="kid-full-name" type="text" disabled="@isSaving" autocomplete="name" placeholder="Ej. Martina López" @bind="draft.FullName" @bind:event="oninput" class="w-full rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[13px] text-[15px] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus:border-[#F2937A] disabled:cursor-not-allowed disabled:opacity-60" />
                    @if (fullNameError is not null)
                    {
                        <p class="mt-1.5 text-[13px] font-semibold text-[#C5503A]">@fullNameError</p>
                    }
                </div>

                <div class="grid gap-[18px] sm:grid-cols-2 sm:gap-[14px]">
                    <div>
                        <label class="mb-2 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="kid-birth-date">FECHA DE NACIMIENTO</label>
                        <input id="kid-birth-date" type="date" disabled="@isSaving" @bind="draft.BirthDate" @bind:format="yyyy-MM-dd" class="w-full rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[13px] text-[15px] text-[#3F362E] outline-none focus:border-[#F2937A] disabled:cursor-not-allowed disabled:opacity-60" />
                        @if (birthDateError is not null)
                        {
                            <p class="mt-1.5 text-[13px] font-semibold text-[#C5503A]">@birthDateError</p>
                        }
                    </div>

                    <div>
                        <label class="mb-2 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="kid-room">SALA</label>
                        <div class="relative">
                            <select id="kid-room" disabled="@isSaving" @bind="draft.RoomId" class="w-full cursor-pointer appearance-none rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[13px] pr-10 text-[15px] font-bold text-[#3F362E] outline-none focus:border-[#F2937A] disabled:cursor-not-allowed disabled:opacity-60">
                                <option value="">Selecciona una sala</option>
                                @foreach (var room in Rooms)
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            </select>
                            <svg class="pointer-events-none absolute inset-y-0 right-4 my-auto size-4 text-[#B0A290]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </div>
                        @if (roomError is not null)
                        {
                            <p class="mt-1.5 text-[13px] font-semibold text-[#C5503A]">@roomError</p>
                        }
                    </div>
                </div>

                <div>
                    <label class="mb-2 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="kid-allergies">ALERGIAS</label>
                    <input id="kid-allergies" type="text" disabled="@isSaving" placeholder="Ej. Cacahuetes, lactosa" @bind="draft.Allergies" @bind:event="oninput" class="w-full rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[13px] text-[15px] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus:border-[#F2937A] disabled:cursor-not-allowed disabled:opacity-60" />
                </div>

                <div>
                    <label class="mb-2 block text-xs font-extrabold tracking-[0.7px] text-[#94887B]" for="kid-medical-notes">NOTAS MÉDICAS</label>
                    <textarea id="kid-medical-notes" disabled="@isSaving" placeholder="Indicaciones, medicación, contactos..." @bind="draft.MedicalNotes" @bind:event="oninput" class="min-h-[90px] w-full resize-y rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-[13px] text-[15px] leading-6 text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus:border-[#F2937A] disabled:cursor-not-allowed disabled:opacity-60"></textarea>
                </div>

                @if (saveError is not null)
                {
                    <p class="rounded-[12px] border border-[#E8B2A5] bg-[#FFF1ED] px-3 py-2 text-[13px] font-semibold text-[#C5503A]" role="alert">@saveError</p>
                }
            </form>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<CreateChildRequest> OnSave { get; set; }

    [Parameter]
    public IReadOnlyList<Room> Rooms { get; set; } = Array.Empty<Room>();

    private readonly AddKidDraft draft = new();
    private string? fullNameError;
    private string? birthDateError;
    private string? roomError;
    private string? saveError;
    private ElementReference modalOverlay;
    private bool shouldFocusModal;
    private bool wasOpen;
    private bool isSaving;

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            shouldFocusModal = true;
        }

        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusModal)
        {
            shouldFocusModal = false;
            await modalOverlay.FocusAsync(preventScroll: true);
        }
    }

    private async Task HandleSaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        var birthDate = draft.BirthDate;
        var roomId = draft.RoomId;
        fullNameError = string.IsNullOrWhiteSpace(draft.FullName) ? "Introduce el nombre completo." : null;
        birthDateError = birthDate switch
        {
            null => "Introduce la fecha de nacimiento.",
            var date when date > DateOnly.FromDateTime(DateTime.Today) => "La fecha de nacimiento no puede ser futura.",
            _ => null
        };
        roomError = roomId is null ? "Selecciona una sala." : null;

        if (fullNameError is not null || birthDateError is not null || roomError is not null || birthDate is null || roomId is null)
        {
            return;
        }

        isSaving = true;
        saveError = null;

        try
        {
            await OnSave.InvokeAsync(new CreateChildRequest(
                draft.FullName,
                birthDate.Value,
                roomId.Value,
                draft.Allergies,
                draft.MedicalNotes));
            ResetDraft();
        }
        catch
        {
            saveError = "No se pudo guardar el niño. Inténtalo de nuevo.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task HandleCancelAsync() => CloseAsync(OnCancel);

    private Task HandleBackdropClickAsync() => isSaving ? Task.CompletedTask : CloseAsync(OnCancel);

    private Task HandleKeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape"
        ? HandleBackdropClickAsync()
        : Task.CompletedTask;

    private async Task CloseAsync(EventCallback callback)
    {
        ResetDraft();
        await callback.InvokeAsync();
    }

    private void ResetDraft()
    {
        draft.FullName = string.Empty;
        draft.BirthDate = null;
        draft.RoomId = null;
        draft.Allergies = string.Empty;
        draft.MedicalNotes = string.Empty;
        fullNameError = null;
        birthDateError = null;
        roomError = null;
        saveError = null;
    }

    private sealed class AddKidDraft
    {
        public string FullName { get; set; } = string.Empty;
        public DateOnly? BirthDate { get; set; }
        public Guid? RoomId { get; set; }
        public string Allergies { get; set; } = string.Empty;
        public string MedicalNotes { get; set; } = string.Empty;
    }
}
