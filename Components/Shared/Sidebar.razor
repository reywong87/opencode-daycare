<div class="contents">
    <input id="sidebar-menu" type="checkbox" class="peer sr-only" />

    <header class="sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-[#ECE0D0] bg-[#FFFDF9] px-5 md:hidden">
        <div class="flex items-center gap-2.5">
            <div class="flex size-9 items-center justify-center rounded-xl bg-linear-to-br from-[#F8C3A8] to-[#F2937A] text-white">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
            </div>
            <div>
                <p class="font-fredoka text-[17px] font-semibold leading-none">OpenDayCare</p>
                <p class="mt-0.5 text-[11.5px] text-[#A89A8B]">Sala Soles</p>
            </div>
        </div>
        <label for="sidebar-menu" class="flex size-10 cursor-pointer items-center justify-center rounded-xl bg-[#F6ECDF] text-[#6E6359]" aria-label="Abrir menú">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </label>
    </header>

    <label for="sidebar-menu" class="fixed inset-0 z-30 hidden bg-[#3F362E]/35 peer-checked:block md:hidden" aria-label="Cerrar menú"></label>

    <aside class="fixed inset-y-0 left-0 z-40 flex w-[248px] -translate-x-full flex-col border-r border-[#ECE0D0] bg-[#FFFDF9] px-4 py-6 transition-transform duration-200 peer-checked:translate-x-0 md:sticky md:top-0 md:h-screen md:translate-x-0">
        <div class="flex items-center justify-between px-2 pb-[22px]">
            <div class="flex items-center gap-[11px]">
                <div class="flex size-[38px] items-center justify-center rounded-xl bg-linear-to-br from-[#F8C3A8] to-[#F2937A] text-white">
                    <svg class="size-[21px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                </div>
                <div>
                    <p class="font-fredoka text-[17px] font-semibold leading-none">OpenDayCare</p>
                    <p class="mt-0.5 text-[11.5px] text-[#A89A8B]">Sala Soles</p>
                </div>
            </div>
            <label for="sidebar-menu" class="flex size-8 cursor-pointer items-center justify-center rounded-lg bg-[#F6ECDF] text-[#94887B] md:hidden" aria-label="Cerrar menú">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="m6 6 12 12M18 6 6 18" />
                </svg>
            </label>
        </div>

        <button type="button" class="mb-[18px] flex w-full items-center justify-center gap-2 rounded-[14px] bg-linear-to-b from-[#F4977E] to-[#EE8164] px-3 py-3 text-[14.5px] font-extrabold text-white shadow-[0_8px_18px_-8px_rgba(238,129,100,0.75)]" @onclick="OnNewPost">
            <svg class="size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nueva publicación
        </button>

        <nav class="flex flex-1 flex-col gap-1" aria-label="Navegación principal">
            <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center gap-3 rounded-xl px-3 py-[11px] text-[14.5px] font-semibold text-[#6E6359]" ActiveClass="bg-[#FBE3D8] !font-extrabold !text-[#D9583C]">
                <svg class="size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
                </svg>
                Feed
            </NavLink>
            <NavLink href="/kids" class="flex items-center gap-3 rounded-xl px-3 py-[11px] text-[14.5px] font-semibold text-[#6E6359]" ActiveClass="bg-[#FBE3D8] !font-extrabold !text-[#D9583C]">
                <svg class="size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="7" r="3" />
                    <circle cx="17" cy="9" r="2.4" />
                    <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 20a5 5 0 0 1 5.5-4.9" />
                </svg>
                Niños
            </NavLink>
            <button type="button" class="flex items-center gap-3 rounded-xl px-3 py-[11px] text-left text-[14.5px] font-semibold text-[#6E6359]">
                <svg class="size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" />
                </svg>
                Avisos
            </button>
            <button type="button" class="flex items-center gap-3 rounded-xl px-3 py-[11px] text-left text-[14.5px] font-semibold text-[#6E6359]">
                <svg class="size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Mi cuenta
            </button>
        </nav>

        <div class="mt-2.5 border-t border-[#ECE0D0] pt-3.5">
            <div class="flex items-center gap-[11px] px-2 py-1.5">
                <Avatar Initials="C" BackgroundClass="bg-[#F2937A]" TextClass="text-white" SizeClass="size-[38px] text-base" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-extrabold text-[#3F362E]">Caro Giménez</p>
                    <p class="text-xs text-[#A89A8B]">Maestra · Soles</p>
                </div>
                <button type="button" class="flex size-8 items-center justify-center rounded-[10px] bg-[#F6ECDF] text-[#94887B]" aria-label="Cerrar sesión">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                    </svg>
                </button>
            </div>
        </div>
    </aside>
</div>

@code {
    [Parameter]
    public EventCallback OnNewPost { get; set; }
}
