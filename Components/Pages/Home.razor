@page "/"
@using OpenDaycare.Components.Shared
@using OpenDaycare.Dtos
@inject PostService PostService
@inject WallPostUiState WallState
@inject SupabaseAuthService AuthService
@implements IDisposable

<PageTitle>OpenDayCare</PageTitle>

<div class="mx-auto w-full max-w-[760px] px-5 py-8 md:px-10 md:pb-20 md:pt-[34px]">
    <header class="mb-6">
        <p class="mb-1 text-[12.5px] font-extrabold tracking-[0.8px] text-[#D9583C]">GUARDERÍA · SALA SOLES</p>
        <h1 class="font-fredoka text-[30px] font-semibold text-[#3F362E]">Buenas, Caro</h1>
        <p class="mt-1 text-[14.5px] text-[#94887B]">12 niños · martes 17 jun</p>
    </header>

    <button type="button" class="mb-6 flex w-full items-center gap-3.5 rounded-[18px] border border-[#ECE0D0] bg-[#FFFDF9] px-[18px] py-3.5 text-left shadow-[0_4px_14px_-10px_rgba(120,90,60,0.4)]">
        <Avatar Initials="C" BackgroundClass="bg-[#F2937A]" TextClass="text-white" SizeClass="size-10 text-base" />
        <span class="flex-1 text-[15px] text-[#A89A8B]">Compartí un momento…</span>
        <span class="flex size-[38px] items-center justify-center rounded-xl bg-[#FBE3D8] text-[#E0654A]">
            <svg class="size-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                <circle cx="12" cy="13" r="4" />
            </svg>
        </span>
    </button>

    <div class="mb-3.5 flex items-center gap-3.5">
        <span class="text-[12.5px] font-extrabold tracking-[0.8px] text-[#8A7C6D]">PUBLICADO HOY</span>
        <span class="h-px flex-1 bg-[#E7DAC8]"></span>
    </div>

    @if (isLoading)
    {
        <p class="rounded-[18px] border border-[#ECE0D0] bg-[#FFFDF9] px-5 py-6 text-center text-[14px] text-[#94887B]" role="status">Cargando publicaciones…</p>
    }
    else if (loadError is not null)
    {
        <div class="rounded-[18px] border border-[#EBC7BC] bg-[#FFF8F5] px-5 py-6 text-center" role="alert">
            <p class="text-[14px] font-semibold text-[#C5503A]">No se pudo cargar el muro.</p>
            <button type="button" class="mt-3 rounded-full bg-[#D9583C] px-4 py-2 text-[13px] font-extrabold text-white" @onclick="LoadFeedAsync">Reintentar</button>
        </div>
    }
    else if (feed.Count == 0)
    {
        <p class="rounded-[18px] border border-dashed border-[#DBCDBA] bg-[#FFFDF9] px-5 py-10 text-center text-[14px] text-[#94887B]">Todavía no hay publicaciones en el muro.</p>
    }
    else
    {
        <section class="flex flex-col gap-4" aria-label="Publicaciones del muro">
            @foreach (var post in feed)
            {
                <PostCard Title="@post.AuthorName"
                          Subtitle="@FormatPublishedAt(post.PublishedAt)"
                          Kind="@GetPostKind(post.Type)"
                          Recipient="la guardería"
                          Message="@post.Body"
                          Photos="@post.Photos"
                          CanManage="@IsAuthor(post)"
                          OnEditClick="@(() => RequestEdit(post))"
                          OnDeleteClick="@(() => RequestDelete(post))" />
            }
        </section>
    }
</div>

@code {
    private readonly List<PostFeedItem> feed = [];
    private bool isLoading = true;
    private string? loadError;
    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        WallState.PostChanged += HandlePostChanged;
        try
        {
            currentUserId = (await AuthService.GetAuthenticatedUserAsync())?.Id;
        }
        catch
        {
            currentUserId = null;
        }

        await LoadFeedAsync();
    }

    private async Task LoadFeedAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            feed.Clear();
            feed.AddRange(await PostService.GetFeedAsync());
        }
        catch
        {
            loadError = "No se pudo cargar el muro.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandlePostChanged() => _ = InvokeAsync(async () =>
    {
        await LoadFeedAsync();
        StateHasChanged();
    });

    private bool IsAuthor(PostFeedItem post) => currentUserId == post.AuthorId;

    private void RequestEdit(PostFeedItem post) => WallState.RequestEdit(post);

    private void RequestDelete(PostFeedItem post) => WallState.RequestDelete(post);

    private static string GetPostKind(string type) => type switch
    {
        "meal" => "Comida",
        "nap" => "Siesta",
        "activity" => "Actividad",
        "achievement" => "Logro",
        "mood" => "Ánimo",
        "photo" => "Foto",
        "announcement" => "Anuncio",
        _ => type
    };

    private static string FormatPublishedAt(DateTimeOffset publishedAt) =>
        publishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    public void Dispose()
    {
        WallState.PostChanged -= HandlePostChanged;
    }
}
