@page "/login"
@layout AuthLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Supabase.Gotrue.Exceptions
@inject NavigationManager Navigation
@inject SupabaseAuthService AuthService
@inject SupabaseAuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Iniciar sesión | OpenDayCare</PageTitle>

<div class="min-h-screen bg-[#FBF4EC] lg:grid lg:grid-cols-[1.05fr_1fr]">
    <aside aria-label="Acerca de OpenDayCare" class="relative hidden overflow-hidden bg-linear-155 from-[#C5503A] via-[#C04B37] to-[#B74733] px-[60px] py-14 text-white lg:flex lg:flex-col lg:justify-between">
        <div class="absolute -right-[120px] -top-[140px] size-[420px] rounded-full bg-white/12"></div>
        <div class="absolute -bottom-[110px] -left-20 size-[300px] rounded-full bg-white/10"></div>

        <div class="relative flex items-center gap-[13px]">
            <div class="flex size-[46px] items-center justify-center rounded-[14px] bg-white/22">
                <svg class="size-[26px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
            </div>
            <span class="font-fredoka text-[21px] font-semibold tracking-[0.5px]">OpenDayCare</span>
        </div>

        <div class="relative">
            <p class="font-fredoka text-[42px] leading-[1.12] font-semibold">El día de cada niño,<br />compartido con su familia.</p>
            <p class="mt-[18px] max-w-[430px] text-[17px] leading-[1.6]">Publica momentos, gestiona las salas y mantén a las familias cerca, desde un solo lugar.</p>
        </div>

        <p class="relative text-sm">🌿 Guardería Sala Soles</p>
    </aside>

    <section aria-labelledby="login-title" class="flex min-h-screen items-center justify-center px-10 py-10">
        <div class="w-full max-w-[392px]">
            <h1 id="login-title" class="font-fredoka text-[30px] font-semibold text-[#3F362E]">Iniciar sesión</h1>
            <p class="mt-1.5 text-[15px] text-[#74675B]">Inicia sesión para ver el día de hoy.</p>

            <EditForm Model="login" OnValidSubmit="HandleValidSubmit" class="mt-7" novalidate>
                <DataAnnotationsValidator />
                <fieldset disabled="@isFormDisabled" aria-busy="@isSubmitting" class="m-0 min-w-0 border-0 p-0">
                    <div>
                        <label class="mb-2 block text-xs font-bold tracking-[0.7px] text-[#74675B]" for="login-email">EMAIL</label>
                        <InputText id="login-email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" required="true" aria-required="true" aria-describedby="login-email-error" @bind-Value="login.Email" class="w-full rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-3.5 text-[15px] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus-visible:border-[#B74733] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3F362E]" />
                        <ValidationMessage For="() => login.Email" id="login-email-error" role="alert" class="mt-1.5 block text-[13px] font-semibold text-[#B74733]" />
                    </div>

                    <div class="mt-[18px]">
                        <label class="mb-2 block text-xs font-bold tracking-[0.7px] text-[#74675B]" for="login-password">CONTRASEÑA</label>
                        <InputText id="login-password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required="true" aria-required="true" aria-describedby="login-password-error" @bind-Value="login.Password" class="w-full rounded-[14px] border-[1.5px] border-[#EADFD0] bg-white px-4 py-3.5 text-[15px] text-[#3F362E] outline-none placeholder:text-[#B6A99B] focus-visible:border-[#B74733] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3F362E]" />
                        <ValidationMessage For="() => login.Password" id="login-password-error" role="alert" class="mt-1.5 block text-[13px] font-semibold text-[#B74733]" />
                    </div>

                    <div class="mt-2.5 text-right">
                        <button type="button" class="min-h-6 cursor-pointer px-1 text-[13.5px] font-bold text-[#B74733] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3F362E]">¿Olvidaste tu contraseña?</button>
                    </div>

                    @if (!string.IsNullOrEmpty(loginError))
                    {
                        <p class="mt-4 text-center text-[13px] font-semibold text-[#B74733]" role="alert">@loginError</p>
                    }

                    <button type="submit" disabled="@isSubmitting" class="mt-5 w-full cursor-pointer rounded-[15px] bg-linear-to-b from-[#C5503A] to-[#B74733] px-4 py-[15px] text-base font-extrabold text-white shadow-[0_10px_22px_-8px_rgba(183,71,51,0.7)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3F362E] disabled:cursor-wait disabled:opacity-70">@(isSubmitting ? "Iniciando sesión..." : "Iniciar sesión")</button>
                </fieldset>
            </EditForm>

            <p class="mt-6 text-center text-[14.5px] text-[#74675B]">¿Te ha invitado la guardería? <a class="font-extrabold text-[#B74733] underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3F362E]" href="/activate-account" @onclick="NavigateToActivation" @onclick:preventDefault="true">Activa tu cuenta</a></p>
        </div>
    </section>
</div>

@code {
    private readonly LoginForm login = new();
    private bool isFormDisabled = true;
    private bool isSubmitting;
    private string? loginError;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? returnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isFormDisabled = !RendererInfo.IsInteractive;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            NavigateToReturnUrl();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        loginError = null;

        try
        {
            bool signedIn;
            try
            {
                signedIn = await AuthService.SignInAsync(login.Email, login.Password);
            }
            catch (HttpRequestException)
            {
                loginError = "No se pudo conectar. Inténtalo de nuevo en unos minutos.";
                return;
            }
            catch (GotrueException exception)
                when (exception.Reason == FailureHint.Reason.Offline ||
                      exception.InnerException is HttpRequestException)
            {
                loginError = "No se pudo conectar. Inténtalo de nuevo en unos minutos.";
                return;
            }
            catch (GotrueException)
            {
                loginError = "El email o la contraseña no son correctos.";
                return;
            }
            catch
            {
                loginError = "No se pudo iniciar sesión. Inténtalo de nuevo en unos minutos.";
                return;
            }

            if (!signedIn)
            {
                loginError = "El email o la contraseña no son correctos.";
                return;
            }

            try
            {
                if (!await AuthenticationStateProvider.RefreshAuthenticationStateAsync())
                {
                    loginError = "No podemos acceder a tu cuenta en este momento.";
                    return;
                }

                NavigateToReturnUrl();
            }
            catch (HttpRequestException)
            {
                loginError = "No se pudo cargar tu perfil. Inténtalo de nuevo en unos minutos.";
            }
            catch
            {
                loginError = "No se pudo cargar tu perfil. Inténtalo de nuevo en unos minutos.";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateToActivation()
    {
        Navigation.NavigateTo("/activate-account");
    }

    private void NavigateToReturnUrl()
    {
        Navigation.NavigateTo(IsValidReturnUrl(returnUrl) ? returnUrl! : "/", replace: true);
    }

    private static bool IsValidReturnUrl(string? candidate) =>
        !string.IsNullOrWhiteSpace(candidate) &&
        candidate.StartsWith('/') &&
        !candidate.StartsWith("//") &&
        !candidate.Contains('\\');

    private sealed class LoginForm
    {
        [Required(ErrorMessage = "Ingresa tu email.")]
        [EmailAddress(ErrorMessage = "Ingresa un email válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu contraseña.")]
        public string Password { get; set; } = string.Empty;
    }
}
