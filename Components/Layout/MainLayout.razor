@inherits LayoutComponentBase

<div class="min-h-screen bg-[#F6ECDF] text-[#3F362E]">
    <main class="min-h-screen min-w-0">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="fixed bottom-0 left-0 z-50 w-full bg-amber-100 px-5 py-3 text-sm text-[#3F362E] shadow-[0_-1px_2px_rgba(0,0,0,0.2)]" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload font-extrabold underline">Reload</a>
    <span class="dismiss absolute right-3 top-2 cursor-pointer">🗙</span>
</div>
